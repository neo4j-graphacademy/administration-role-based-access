// Seed data for the role-based access lab.
// A small subset of the GraphAcademy recommendations dataset.
// The email and dateOfBirth values on User are synthetic.
CREATE CONSTRAINT movie_id IF NOT EXISTS FOR (m:Movie) REQUIRE m.movieId IS UNIQUE;
CREATE CONSTRAINT user_id IF NOT EXISTS FOR (u:User) REQUIRE u.userId IS UNIQUE;
CREATE CONSTRAINT genre_name IF NOT EXISTS FOR (g:Genre) REQUIRE g.name IS UNIQUE;

UNWIND [
  {movieId: '356', title: 'Forrest Gump', year: 1994, imdbRating: 8.8, genres: ['Comedy', 'Romance', 'Drama', 'War']},
  {movieId: '296', title: 'Pulp Fiction', year: 1994, imdbRating: 8.9, genres: ['Comedy', 'Drama', 'Crime', 'Thriller']},
  {movieId: '1197', title: 'Princess Bride, The', year: 1987, imdbRating: 8.1, genres: ['Adventure', 'Comedy', 'Fantasy', 'Romance', 'Action']},
  {movieId: '2762', title: 'Sixth Sense, The', year: 1999, imdbRating: 8.1, genres: ['Drama', 'Horror', 'Mystery']},
  {movieId: '318', title: 'Shawshank Redemption, The', year: 1994, imdbRating: 9.3, genres: ['Drama', 'Crime']},
  {movieId: '110', title: 'Braveheart', year: 1995, imdbRating: 8.4, genres: ['Drama', 'Action', 'War']},
  {movieId: '527', title: 'Schindler\'s List', year: 1993, imdbRating: 8.9, genres: ['Drama', 'War']},
  {movieId: '588', title: 'Aladdin', year: 1992, imdbRating: 8.0, genres: ['Adventure', 'Animation', 'Children', 'Comedy', 'Musical']},
  {movieId: '1210', title: 'Star Wars: Episode VI - Return of the Jedi', year: 1983, imdbRating: 8.4, genres: ['Adventure', 'Action', 'Sci-Fi']},
  {movieId: '1196', title: 'Star Wars: Episode V - The Empire Strikes Back', year: 1980, imdbRating: 8.8, genres: ['Adventure', 'Action', 'Sci-Fi']},
  {movieId: '2571', title: 'Matrix, The', year: 1999, imdbRating: 8.7, genres: ['Action', 'Thriller', 'Sci-Fi']},
  {movieId: '50', title: 'Usual Suspects, The', year: 1995, imdbRating: 8.6, genres: ['Crime', 'Thriller', 'Mystery']},
  {movieId: '47', title: 'Seven (a.k.a. Se7en)', year: 1995, imdbRating: 8.6, genres: ['Thriller', 'Mystery']},
  {movieId: '592', title: 'Batman', year: 1989, imdbRating: 7.6, genres: ['Action', 'Crime', 'Thriller']},
  {movieId: '590', title: 'Dances with Wolves', year: 1990, imdbRating: 8.0, genres: ['Adventure', 'Drama', 'Western']},
  {movieId: '589', title: 'Terminator 2: Judgment Day', year: 1991, imdbRating: 8.5, genres: ['Action', 'Sci-Fi']},
  {movieId: '593', title: 'Silence of the Lambs, The', year: 1991, imdbRating: 8.6, genres: ['Crime', 'Thriller', 'Horror']},
  {movieId: '364', title: 'Lion King, The', year: 1994, imdbRating: 8.5, genres: ['Adventure', 'Animation', 'Children', 'Drama', 'IMAX', 'Musical']},
  {movieId: '367', title: 'Mask, The', year: 1994, imdbRating: 6.9, genres: ['Comedy', 'Fantasy', 'Action', 'Crime']},
  {movieId: '377', title: 'Speed', year: 1994, imdbRating: 7.2, genres: ['Romance', 'Action', 'Thriller']}
] AS row
MERGE (m:Movie {movieId: row.movieId})
SET m.title = row.title, m.year = row.year, m.imdbRating = row.imdbRating
WITH m, row
UNWIND row.genres AS genre
MERGE (g:Genre {name: genre})
MERGE (m)-[:IN_GENRE]->(g);

